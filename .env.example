# Koobiyee faylkan una beddel ".env" oo geli qiimayaashaada
PORT=3000
NODE_ENV=production

# Admin-ka ugu horreeya (waxaa la sameeyaa marka server-ku ugu horreyo bilaabmo)
ADMIN_EMAIL=emailkaaga@tusaale.com
ADMIN_PASSWORD=beddel-password-adag

# Lambarka WhatsApp (iyada oo aan + lahayn, tusaale 252631234567)
WHATSAPP=252000000000

# Habka lacag-bixinta: Magac:Lambar, kala saar koma (,)
PAYMENTS=EVC Plus:61 000 0000,Zaad:63 000 0000,eDahab:65 000 0000

# Ikhtiyaari: halka database-ku ku jiro (u isticmaal disk joogto ah)
# DATA_DIR=/var/data
